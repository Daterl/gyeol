# 서버에서만 사용. 실제 키는 커밋하지 않는다.
ANTHROPIC_API_KEY=
GYEOL_ANALYSIS_RECEIPT_SECRET=
# Private Vercel Blob 공유·프로필 캐시와 인증된 정리 작업.
# 프로필 live 검증: docs/specs/68-live-profile/report.md, npm run verify:profile -- --check
# 각 signing/access secret은 서로 다른 32자 이상 난수. NEXT_PUBLIC_* 사용 금지.
BLOB_READ_WRITE_TOKEN=
SHARE_STORAGE_SECRET=
PROFILE_CACHE_SECRET=
CRON_SECRET=
# 익명 브라우저 프로필 연결 세션. origin은 배포 URL의 https origin만 입력한다.
GYEOL_BROWSER_SESSION_SECRET=
GYEOL_APP_ORIGIN=
# 선택: 생략하면 config/models.json 기본값. 호출 시 계정 접근 확인.
# GYEOL_VISION_MODEL=

# 선택 라이브 공개 Instagram 수집. 세 비밀값은 서로 달라야 한다.
APIFY_TOKEN=
APIFY_INGEST_ACCESS_KEY=
APIFY_INGEST_RECEIPT_SECRET=
# persistent process reference ledger의 인증 호출자 누적 예약 비용. 기본 0.10 USD.
# /api/ingest는 durable ledger 없이는 start를 거부한다.
# 브라우저 /api/profile은 Private Blob reservation과 durable 요청 제한을 사용한다.
# APIFY_INGEST_SESSION_BUDGET_USD=0.10

{
  "name": "gyeol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "next start",
    "test": "node --test test/*.test.js",
    "eval": "node eval/run.js",
    "check": "node scripts/check.js",
    "build": "next build",
    "dev": "next dev",
    "start:mock": "node scripts/server.js",
    "test:ui": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",

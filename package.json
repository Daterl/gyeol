    "test:smoke": "node scripts/smoke-next.js",
    "verify:deployed": "node scripts/verify-deployed.mjs",
    "verify:profile": "node scripts/verify-profile-live.js"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "cn": "^0.3.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
